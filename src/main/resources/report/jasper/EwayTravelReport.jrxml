		<field name="TRAVEL_COVER_DURATION" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="TRAVEL_COVER_DURATION"/>
			<property name="com.jaspersoft.studio.field.label" value="TRAVEL_COVER_DURATION"/>
