	<parameter name="pvImagePath" class="java.lang.String"/>
	<parameter name="pvPolicyNo" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
HPM.QUOTE_NO,
HPM.POLICY_NO,
(SELECT UPPER(CONCAT(CONCAT(PIF.TITLE_DESC,'.'),PIF.CLIENT_NAME)) FROM personal_info  PIF WHERE PIF.Customer_Id=HPM.Customer_Id) AS INSURED_NAME,
(SELECT PIF.Address_1 FROM personal_info PIF WHERE PIF.Customer_Id=HPM.Customer_Id) AS ADDRESS1,
(SELECT PIF.Address_2 FROM personal_info PIF WHERE PIF.Customer_Id=HPM.Customer_Id) AS ADDRESS2,
(SELECT TELEPHONE_NO_1 FROM PERSONAL_INFO PI WHERE PI.CUSTOMER_ID = HPM.CUSTOMER_ID) AS PHONE_NUMBER,
(SELECT AGENCY_CODE FROM EWAY_LOGIN_MASTER LM WHERE LM.LOGIN_ID = HPM.LOGIN_ID) AS AGENCY_CODE,
HPM.inception_date AS FROM_DATE,
HPM.expiry_date AS TO_DATE,
HPM.CURRENCY AS CURRENCY,
CASE WHEN HPM.CURRENCY IN (
    SELECT 
      CURRENCY_ID 
    FROM 
      EWAY_INSURANCE_COMPANY_MASTER 
    WHERE 
      HPM.COMPANY_ID = COMPANY_ID
  ) THEN (SELECT SUM(OVERALL_PREMIUM_LC) FROM TRAVEL_PASSENGER_DETAILS TPD WHERE TPD.QUOTE_NO=HPM.QUOTE_NO)
  ELSE (SELECT SUM(OVERALL_PREMIUM_FC) FROM TRAVEL_PASSENGER_DETAILS TPD WHERE TPD.QUOTE_NO=HPM.QUOTE_NO)
  END AS OVERALL_PREMIUM,
  CASE WHEN HPM.CURRENCY IN (
    SELECT 
      CURRENCY_ID 
    FROM 
      EWAY_INSURANCE_COMPANY_MASTER 
    WHERE 
      HPM.COMPANY_ID = COMPANY_ID
  ) THEN (SELECT SUM(ACTUAL_PREMIUM_LC) FROM TRAVEL_PASSENGER_DETAILS TPD WHERE TPD.QUOTE_NO=HPM.QUOTE_NO)
  ELSE (SELECT SUM(ACTUAL_PREMIUM_FC) FROM TRAVEL_PASSENGER_DETAILS TPD WHERE TPD.QUOTE_NO=HPM.QUOTE_NO)
  END AS PREMIUM,
  (SELECT COUNT(*) FROM TRAVEL_PASSENGER_DETAILS TPD WHERE TPD.QUOTE_NO=HPM.QUOTE_NO) AS NO_OF_PASSENGER
FROM
HOME_POSITION_MASTER HPM
WHERE
    HPM.PRODUCT_ID='4'
AND HPM.STATUS='P'
AND HPM.POLICY_NO=  $P{pvPolicyNo}]]>
	</queryString>
