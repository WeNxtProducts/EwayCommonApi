	<subDataset name="Table Dataset1" uuid="30f1d43b-5352-4c00-81a2-ae4c9d840938">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter4.xml"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="pvPolicyNo" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT ROW_NUMBER() OVER (ORDER BY PASSENGER_NAME) AS SNO,UPPER(PASSENGER_NAME) PASSANGER_NAME,DOB,AGE,RELATION_DESC,PASSPORT_NO,TRAVEL_COVER_DURATION FROM TRAVEL_PASSENGER_DETAILS  WHERE QUOTE_NO = (SELECT QUOTE_NO FROM HOME_POSITION_MASTER WHERE POLICY_NO =  $P{pvPolicyNo} ) order by PASSENGER_NAME]]>
		</queryString>
