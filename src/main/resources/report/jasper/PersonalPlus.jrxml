	<subDataset name="TableDataset1" uuid="dcdfbb29-0d8d-4a37-8d12-f16100385407">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.xml"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="pvPolicyNo" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT
CAST(BRD.AllRisk_Suminsured AS CHAR(50)) AS AllRisk_Suminsured ,
CAST(BRD.Personal_Int_Suminsured AS CHAR(50)) AS Personal_Int_Suminsured ,
BRD.Content_Suminsured,
CAST(BRD.Workmen_Comp_Suminsured AS CHAR(50)) AS Workmen_Comp_Suminsured
FROM home_position_master HPM ,BUILDING_RISK_DETAILS BRD
WHERE
BRD.QUOTE_NO=HPM.QUOTE_NO
AND
HPM.POLICY_NO= $P{pvPolicyNo}]]>
		</queryString>
		<field name="AllRisk_Suminsured" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="AllRisk_Suminsured"/>
			<property name="com.jaspersoft.studio.field.label" value="AllRisk_Suminsured"/>
		</field>
		<field name="Personal_Int_Suminsured" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Personal_Int_Suminsured"/>
			<property name="com.jaspersoft.studio.field.label" value="Personal_Int_Suminsured"/>
		</field>
		<field name="Content_Suminsured" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="CONTENT_SUMINSURED"/>
			<property name="com.jaspersoft.studio.field.label" value="Content_Suminsured"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="building_risk_details"/>
		</field>
		<field name="Workmen_Comp_Suminsured" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Workmen_Comp_Suminsured"/>
			<property name="com.jaspersoft.studio.field.label" value="Workmen_Comp_Suminsured"/>
		</field>
	</subDataset>
	<subDataset name="TableDataset2" uuid="3a469cc9-31bf-4c0e-8a35-ead310ce49fe">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.xml"/>
		<parameter name="pvPolicyNo" class="java.lang.String"/>
		<queryString language="SQL">
			<![CDATA[SELECT
ROW_NUMBER() OVER () AS serial_no,
MDD.INSURANCE_TYPE_DESC AS DESCRIPTION_,
HPM.COVER_NOTE_NUMBER AS COVERNOTE_NO,
HPM.CURRENCY AS CURRENCY,
MDD.SUM_INSURED AS SUM_INSURED,
CONCAT_WS("/",MDD.VEHICLE_MAKE,MDD.VEHCILE_MODEL) AS DETAILS
FROM home_position_master HPM,MOTOR_DATA_DETAILS MDD
WHERE
HPM.PRODUCT_ID='5' AND HPM.SECTION_ID NOT IN('1','35') AND
MDD.POLICY_NO=HPM.POLICY_NO AND HPM.POLICY_NO=$P{pvPolicyNo}
UNION ALL
SELECT
ROW_NUMBER() OVER () AS serial_no,
BD.BUILDING_USAGE_DESC AS DESCRIPTION_,
HPM.COVER_NOTE_NUMBER AS COVERNOTE_NO,
HPM.CURRENCY AS CURRENCY,
CAST(BD.BUILDING_SUMINSURED AS DOUBLE) AS SUM_INSURED,
BD.BUILDING_ADDRESS AS DETAILS
FROM home_position_master HPM,BUILDING_DETAILS BD
WHERE
(HPM.PRODUCT_ID='3' OR HPM.PRODUCT_ID='19') AND
BD.REQUEST_REFERENCE_NO=HPM.REQUEST_REFERENCE_NO AND HPM.POLICY_NO=$P{pvPolicyNo}
UNION ALL
SELECT
ROW_NUMBER() OVER () AS serial_no,
TPD.TRAVEL_COVER_DESC AS DESCRIPTION_,
HPM.COVER_NOTE_NUMBER AS COVERNOTE_NO,
HPM.CURRENCY AS CURRENCY,
TPD.BASE_PREMIUM AS SUM_INSURED,
CONCAT_WS("TO",TPD.SOURCE_COUNTRY_DESC,TPD.DESTINATION_COUNTRY_DESC) AS DETAILS
FROM home_position_master HPM,TRAVEL_PASSENGER_DETAILS TPD
WHERE
HPM.PRODUCT_ID='4' AND
TPD.QUOTE_NO=HPM.QUOTE_NO  AND HPM.POLICY_NO=$P{pvPolicyNo}
UNION ALL
SELECT
ROW_NUMBER() OVER () AS serial_no,
ECD.SECTION_DESC AS DESCRIPTION_,
HPM.COVER_NOTE_NUMBER AS COVERNOTE_NO,
HPM.CURRENCY AS CURRENCY,
CAST(SUM_INSURED AS DOUBLE)AS SUM_INSURED,
ECD.CUSTOMER_NAME AS DETAILS
FROM home_position_master HPM,common_data_details ECD
WHERE
ECD.REQUEST_REFERENCE_NO=HPM.REQUEST_REFERENCE_NO AND
HPM.POLICY_NO=$P{pvPolicyNo} AND
((ECD.product_id IN ('5') AND ECD.section_id = '35' ) OR ECD.product_id IN('3') OR (ECD.product_id NOT IN ('3','4','5','19')))]]>
		</queryString>
		<field name="serial_no" class="java.math.BigInteger">
			<property name="com.jaspersoft.studio.field.name" value="serial_no"/>
			<property name="com.jaspersoft.studio.field.label" value="serial_no"/>
		</field>
		<field name="DESCRIPTION_" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="DESCRIPTION_"/>
			<property name="com.jaspersoft.studio.field.label" value="DESCRIPTION_"/>
		</field>
		<field name="COVERNOTE_NO" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="COVERNOTE_NO"/>
			<property name="com.jaspersoft.studio.field.label" value="COVERNOTE_NO"/>
		</field>
		<field name="CURRENCY" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="CURRENCY"/>
			<property name="com.jaspersoft.studio.field.label" value="CURRENCY"/>
		</field>
		<field name="SUM_INSURED" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="SUM_INSURED"/>
			<property name="com.jaspersoft.studio.field.label" value="SUM_INSURED"/>
		</field>
		<field name="DETAILS" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="DETAILS"/>
			<property name="com.jaspersoft.studio.field.label" value="DETAILS"/>
		</field>
		<group name="COVERNOTE_NO">
			<groupExpression><![CDATA[$F{COVERNOTE_NO}]]></groupExpression>
		</group>
		<group name="CURRENCY">
			<groupExpression><![CDATA[$F{CURRENCY}]]></groupExpression>
		</group>
		<group name="SUM_INSURED">
			<groupExpression><![CDATA[$F{SUM_INSURED}]]></groupExpression>
		</group>
		<group name="DETAILS">
			<groupExpression><![CDATA[$F{DETAILS}]]></groupExpression>
		</group>
	</subDataset>
	<parameter name="pvImagepath" class="java.lang.String"/>
	<parameter name="pvPolicyNo" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT
HPM.POLICY_NO,
HPM.INSURED_BY,
(SELECT CONCAT_WS(" ",PIF.Address_1,PIF.Address_2)  FROM personal_info  PIF WHERE PIF.Customer_Id=HPM.Customer_Id )  AS ADDRESS,
HPM.DEBIT_NOTE_NO AS INVOICE_NO,
UPPER(DATE_FORMAT(HPM.inception_date,"%d-%b-%y")) AS FROM_DATE,
UPPER(DATE_FORMAT(HPM.expiry_date,"%d-%b-%y")) AS TO_DATE,
UPPER(DATE_FORMAT(FROM_UNIXTIME(UNIX_TIMESTAMP(HPM.expiry_date) + (3*24*60*60)),"%d %b %Y")) AS RENEWAL_DATE,
HPM.BRANCH_NAME AS PLACE,
DATE_FORMAT(CURDATE(),'%D-%b-%Y') AS PRINTED_DATE,
HPM.COMPANY_NAME AS COMPANY_NAME,
LUI.USER_NAME AS PREPARED_BY,
LUI.USER_NAME AS PRINTED_BY,
UPPER(DATE_FORMAT(CURDATE(),'%d-%b-%y')) AS FOOTER_DATE,
CASE WHEN HPM.SECTION_ID='0' THEN 'BUILDING'
ELSE ( SELECT SECTION_NAME FROM SECTION_MASTER WHERE SECTION_ID = HPM.SECTION_ID LIMIT 1)
END AS SECTION_NAME,
HPM.CURRENCY AS CURRENCY,
HPM.VAT_PERCENT,
CASE WHEN (hpm.currency =cpm.currency_ids) THEN HPM.PREMIUM_LC ELSE HPM.PREMIUM_FC END AS PREMIUM,
CASE WHEN (hpm.currency = cpm.currency_ids) THEN HPM.VAT_PREMIUM_LC ELSE HPM.VAT_PREMIUM_FC END AS VAT,
CASE WHEN (hpm.currency = cpm.currency_ids) THEN HPM.OVERALL_PREMIUM_LC ELSE HPM.OVERALL_PREMIUM_FC END AS TOTAL,
CASE WHEN (HPM.product_id IN ('3')  OR (HPM.product_id NOT IN ('4','5','19')))
 THEN (SELECT SUM(ECD.SUM_INSURED) FROM common_data_details ECD
      WHERE ECD.REQUEST_REFERENCE_NO = HPM.REQUEST_REFERENCE_NO) END AS FOOTER_TOTAL,
CASE WHEN ((HPM.product_id IN ('5') AND HPM.section_id = '35' ) OR (HPM.product_id NOT IN ('3','4','5','19')))
 THEN (SELECT SUM(ECD.SUM_INSURED) FROM common_data_details ECD
      WHERE ECD.REQUEST_REFERENCE_NO = HPM.REQUEST_REFERENCE_NO) END AS FOOTER_TOTAL,
CASE WHEN (HPM.PRODUCT_ID='4')
 THEN (SELECT SUM(TPD.BASE_PREMIUM) FROM TRAVEL_PASSENGER_DETAILS TPD
  WHERE TPD.QUOTE_NO=HPM.QUOTE_NO) END AS FOOTER_TOTAL,
CASE WHEN ((HPM.PRODUCT_ID='3' ) OR HPM.PRODUCT_ID='19')
 THEN (SELECT SUM(BD.BUILDING_SUMINSURED) FROM BUILDING_DETAILS BD
 WHERE BD.REQUEST_REFERENCE_NO=HPM.REQUEST_REFERENCE_NO) END AS FOOTER_TOTAL,
CASE WHEN HPM.PRODUCT_ID = '5' AND HPM.SECTION_ID NOT IN('1','35')
 THEN ( SELECT SUM(MDD.SUM_INSURED) FROM MOTOR_DATA_DETAILS MDD
 WHERE MDD.POLICY_NO=HPM.POLICY_NO) END AS FOOTER_TOTAL
FROM home_position_master HPM , company_product_master cpm,LOGIN_USER_INFO LUI,SECTION_MASTER SEC,
TRAVEL_PASSENGER_DETAILS TPD
WHERE
HPM.POLICY_NO=$P{pvPolicyNo} AND
cpm.company_id = hpm.company_id AND
cpm.product_id = hpm.product_id AND
cpm.amend_id = hpm.amend_id AND
HPM.LOGIN_ID=LUI.LOGIN_ID
LIMIT 1;]]>
	</queryString>
