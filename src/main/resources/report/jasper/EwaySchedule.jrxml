	<subDataset name="LocationDetails" uuid="d156ef96-0b0e-41a5-8e37-d6bdf7bec6c6">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.xml"/>
		<parameter name="pvQuoteNo" class="java.lang.String"/>
		<queryString language="SQL">
			<![CDATA[SELECT LOCATION_NAME,BUILDING_ADDRESS,BUILDING_SUMINSURED FROM Building_Details WHERE Quote_no =$P{pvQuoteNo}]]>
		</queryString>
		<field name="LOCATION_NAME" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="LOCATION_NAME"/>
			<property name="com.jaspersoft.studio.field.label" value="LOCATION_NAME"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="building_details"/>
		</field>
		<field name="BUILDING_ADDRESS" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="BUILDING_ADDRESS"/>
			<property name="com.jaspersoft.studio.field.label" value="BUILDING_ADDRESS"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="building_details"/>
		</field>
		<field name="BUILDING_SUMINSURED" class="java.lang.Long">
			<property name="com.jaspersoft.studio.field.name" value="BUILDING_SUMINSURED"/>
			<property name="com.jaspersoft.studio.field.label" value="BUILDING_SUMINSURED"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="building_details"/>
		</field>
	</subDataset>
	<parameter name="pvImagepath" class="java.lang.String"/>
	<parameter name="pvQuoteNo" class="java.lang.String"/>
	<parameter name="pvSubReportPath" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
HPM.POLICY_NO,HPM.QUOTE_NO,
CONCAT_WS(".",PIF.TITLE_DESC,PIF.CLIENT_NAME) AS INSURED_NAME,
CONCAT_WS(" ",PIF.Address_1,PIF.Address_2) AS ADDRESS,UPPER(DATE_FORMAT(HPM.inception_date,"%d-%b-%y")) AS INCEPTION_DATE,
UPPER(DATE_FORMAT(HPM.expiry_date,"%d-%b-%y")) AS EXPIRY_DATE,HPM.BRANCH_NAME,HPM.BROKER_BRANCH_NAME,HPM.PRODUCT_NAME,PIF.STATE_NAME,PIF.CITY_NAME,
CONCAT_WS("-",PIF.MOBILE_CODE_DESC_1,PIF.MOBILE_NO_1) AS MOBILE_NO ,PIF.CUSTOMER_ID ,LUI.USER_NAME AS BROKER_NAME,LUI.CORE_APP_BROKER_CODE AS BROKER_CODE,HPM.CURRENCY ,
HPM.VAT_PERCENT,
CASE WHEN (LCM.CURRENCY_ID=HPM.CURRENCY) THEN HPM.PREMIUM_LC ELSE HPM.PREMIUM_FC END AS PREMIUM,
CASE WHEN (hpm.currency = LCM.CURRENCY_ID) THEN HPM.VAT_PREMIUM_LC ELSE HPM.VAT_PREMIUM_FC END AS VAT,
CASE WHEN (hpm.currency = LCM.CURRENCY_ID) THEN HPM.OVERALL_PREMIUM_LC ELSE HPM.OVERALL_PREMIUM_FC END AS TOTAL,
LCM.SIGNATURE,
DATE_FORMAT(CURDATE(),'%D-%b-%Y') AS PRINTED_DATE,
LUI.USER_NAME AS PREPARED_BY,
LUI.USER_NAME AS PRINTED_BY,
UPPER(DATE_FORMAT(CURDATE(),'%d-%b-%y')) AS FOOTER_DATE,
LBM.BRANCH_NAME AS PLACE FROM
HOME_POSITION_MASTER HPM,PERSONAL_INFO PIF,LOGIN_USER_INFO LUI,EWAY_INSURANCE_COMPANY_MASTER LCM,
EWAY_LOGIN_BRANCH_MASTER LBM
WHERE
HPM.CUSTOMER_ID = PIF.CUSTOMER_ID AND
HPM.AGENCY_CODE=LUI.AGENCY_CODE AND
HPM.COMPANY_ID=LCM.COMPANY_ID AND
HPM.LOGIN_ID=LBM.LOGIN_ID AND
HPM.COMPANY_ID=LBM.COMPANY_ID AND
HPM.BRANCH_CODE=LBM.BRANCH_CODE AND
LBM.STATUS='Y' AND
LCM.STATUS='Y' AND
CURDATE() BETWEEN LCM.EFFECTIVE_DATE_START AND LCM.EFFECTIVE_DATE_END AND
LCM.AMEND_ID= (SELECT MAX(AMEND_ID) FROM EWAY_INSURANCE_COMPANY_MASTER LCM WHERE 
HPM.COMPANY_ID=LCM.COMPANY_ID AND
LCM.STATUS='Y' AND
CURDATE() BETWEEN LCM.EFFECTIVE_DATE_START AND LCM.EFFECTIVE_DATE_END
) AND
HPM.QUOTE_NO=  $P{pvQuoteNo} ]]>
	</queryString>
