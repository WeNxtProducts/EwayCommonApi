	<subDataset name="Conditions" uuid="ff92c7a7-a7a1-4c21-b3b6-e71b67535bfb">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.xml"/>
		<parameter name="pvQuoteNo" class="java.lang.String"/>
		<parameter name="pvSectionId" class="java.lang.String"/>
		<queryString language="SQL">
			<![CDATA[SELECT ROW_NUMBER() OVER(ORDER BY terms) AS ROW_NUM,terms FROM (
  SELECT CLAUSES_DESCRIPTION AS terms
 FROM CLAUSES_MASTER CM INNER JOIN home_position_master HPM ON
  CM.COMPANY_ID=HPM.COMPANY_ID AND
  CM.PRODUCT_ID=HPM.PRODUCT_ID
 WHERE HPM.QUOTE_NO =$P{pvQuoteNo} AND CM.SECTION_ID= $P{pvSectionId} AND
  (CM.BRANCH_CODE=HPM.BRANCH_CODE OR CM.BRANCH_CODE='99999')AND
  CM.STATUS = 'Y' AND
  CURDATE() BETWEEN CM.EFFECTIVE_DATE_START AND CM.EFFECTIVE_DATE_END AND
  HPM.QUOTE_NO NOT IN (SELECT QUOTE_NO FROM terms_and_condition)
  UNION
  SELECT SUB_ID_DESC AS terms FROM terms_and_condition CM INNER JOIN home_position_master HPM
  ON  CM.COMPANY_ID=HPM.COMPANY_ID AND
  CM.PRODUCT_ID=HPM.PRODUCT_ID
  WHERE  HPM.QUOTE_NO =$P{pvQuoteNo} AND  CM.SECTION_ID= $P{pvSectionId} AND
  HPM.QUOTE_NO IN (CM.QUOTE_NO) AND
  CM.STATUS = 'Y' AND
  (CM.BRANCH_CODE=HPM.BRANCH_CODE OR CM.BRANCH_CODE='99999')
  UNION ALL
  SELECT EXCLUSION_DESCRIPTION AS terms
 FROM EXCLUSION_MASTER CM INNER JOIN home_position_master HPM ON
  CM.COMPANY_ID=HPM.COMPANY_ID AND
  CM.PRODUCT_ID=HPM.PRODUCT_ID
 WHERE HPM.QUOTE_NO =$P{pvQuoteNo} AND  CM.SECTION_ID= $P{pvSectionId} AND
  (CM.BRANCH_CODE=HPM.BRANCH_CODE OR CM.BRANCH_CODE='99999')AND
  CM.STATUS = 'Y' AND
  CURDATE() BETWEEN CM.EFFECTIVE_DATE_START AND CM.EFFECTIVE_DATE_END AND
  HPM.QUOTE_NO NOT IN (SELECT QUOTE_NO FROM terms_and_condition)
  UNION
  SELECT SUB_ID_DESC AS terms FROM terms_and_condition CM INNER JOIN home_position_master HPM
  ON  CM.COMPANY_ID=HPM.COMPANY_ID AND
  CM.PRODUCT_ID=HPM.PRODUCT_ID
  WHERE  HPM.QUOTE_NO =$P{pvQuoteNo} AND  CM.SECTION_ID= $P{pvSectionId} AND
  HPM.QUOTE_NO IN (CM.QUOTE_NO) AND
  CM.STATUS = 'Y' AND
  (CM.BRANCH_CODE=HPM.BRANCH_CODE OR CM.BRANCH_CODE='99999')
  UNION ALL
  SELECT WARRANTY_DESCRIPTION AS terms
 FROM WARRANTY_MASTER CM INNER JOIN home_position_master HPM ON
  CM.COMPANY_ID=HPM.COMPANY_ID AND
  CM.PRODUCT_ID=HPM.PRODUCT_ID
 WHERE HPM.QUOTE_NO =$P{pvQuoteNo} AND  CM.SECTION_ID= $P{pvSectionId} AND
  (CM.BRANCH_CODE=HPM.BRANCH_CODE OR CM.BRANCH_CODE='99999')AND
  CM.STATUS = 'Y' AND
  CURDATE() BETWEEN CM.EFFECTIVE_DATE_START AND CM.EFFECTIVE_DATE_END AND
  HPM.QUOTE_NO NOT IN (SELECT QUOTE_NO FROM terms_and_condition)
  UNION
  SELECT SUB_ID_DESC AS terms FROM terms_and_condition CM INNER JOIN home_position_master HPM
  ON  CM.COMPANY_ID=HPM.COMPANY_ID AND
  CM.PRODUCT_ID=HPM.PRODUCT_ID
  WHERE  HPM.QUOTE_NO =$P{pvQuoteNo} AND  CM.SECTION_ID= $P{pvSectionId} AND
  HPM.QUOTE_NO IN (CM.QUOTE_NO) AND
  CM.STATUS = 'Y' AND
  (CM.BRANCH_CODE=HPM.BRANCH_CODE OR CM.BRANCH_CODE='99999'))X]]>
		</queryString>
		<field name="ROW_NUM" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="ROW_NUM"/>
			<property name="com.jaspersoft.studio.field.label" value="ROW_NUM"/>
		</field>
		<field name="terms" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="terms"/>
			<property name="com.jaspersoft.studio.field.label" value="terms"/>
		</field>
		<group name="ROW_NUM">
			<groupExpression><![CDATA[$F{ROW_NUM}]]></groupExpression>
		</group>
		<group name="terms">
			<groupExpression><![CDATA[$F{terms}]]></groupExpression>
		</group>
	</subDataset>
	<parameter name="pvQuoteNo" class="java.lang.String"/>
	<parameter name="pvSubReportPath" class="java.lang.String"/>
	<parameter name="pvPolicyNo" class="java.lang.String"/>
