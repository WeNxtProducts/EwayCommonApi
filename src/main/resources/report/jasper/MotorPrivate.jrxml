				<textElement verticalAlignment="Middle">
					<font fontName="Arial" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Any person driving on the insured's order or with his permission Provided that the person driving is permitted in accordance with the licensing or other laws or regulations to drive the Motor Vehicle or has been permitted and is not disqualified by order of a Court of Law or by reason of any enactment or regulation in that behalf from driving the Motor Vehicle"]]></textFieldExpression>
