	<subDataset name="TableDataSet 1" uuid="2dfcad32-0f3a-4426-ab2d-d52922456687">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.xml"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="pvPolicyNo" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT MDD.VEHICLE_ID AS SNO,
MDD.REGISTRATION_NUMBER AS REG_NO,
CONCAT_WS("/",MDD.VEHICLE_MAKE,MDD.VEHCILE_MODEL,MDD.VEHICLE_TYPE_DESC) AS VEH_BODY,
MDD.CUBIC_CAPACITY AS CC,
MDD.MANUFACTURE_YEAR AS VEHYEAR,
MDD.COLOR,
MDD.SEATING_CAPACITY NO_OF_SEATS,
MDD.STICKER_NO AS STICKER ,
MDD.WIND_SCREEN_SUM_INSURED AS WIND_SCREEN_AMT,
MDD.SUM_INSURED AS SUM_INSURED
FROM home_position_master HPM,MOTOR_DATA_DETAILS MDD
WHERE MDD.POLICY_NO=HPM.POLICY_NO AND HPM.POLICY_NO= $P{pvPolicyNo};]]>
		</queryString>
		<field name="SNO" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="SNO"/>
			<property name="com.jaspersoft.studio.field.label" value="SNO"/>
		</field>
		<field name="REG_NO" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="REG_NO"/>
			<property name="com.jaspersoft.studio.field.label" value="REG_NO"/>
