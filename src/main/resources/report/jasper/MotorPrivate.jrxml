					<font fontName="Arial" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["3. Windscreen cover if stated in the schedule is subject to deductibles/excess of Tshs 50,000 for each and every loss."]]></textFieldExpression>
			</textField>
