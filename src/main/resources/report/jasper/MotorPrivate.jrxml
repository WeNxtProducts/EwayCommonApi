	<subDataset name="Dataset1" uuid="9e32c451-98c8-4b26-9f0a-7e8235e38ce2">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.xml"/>
		<parameter name="pvQuoteNo" class="java.lang.String"/>
		<parameter name="pvVehicleId" class="java.lang.String"/>
		<queryString language="SQL">
			<![CDATA[SELECT
  PCD.COVER_NAME,
  PCD.SUM_INSURED,
  CASE WHEN hpm.currency IN (cpm.currency_id) THEN PCD.PREMIUM_AFTER_DISCOUNT_LC ELSE PCD.PREMIUM_AFTER_DISCOUNT_FC END AS AFTER_DISCOUNT,
  CASE WHEN hpm.currency IN (cpm.currency_id) THEN PCD.PREMIUM_INCLUDED_TAX_LC ELSE PCD.PREMIUM_INCLUDED_TAX_FC END AS INCLUDED_TAX
  FROM 
  home_position_master HPM,
  Eway_insurance_company_master cpm,
  POLICY_COVER_DATA PCD
  WHERE
  PCD.QUOTE_NO = $P{pvQuoteNo} 
  AND HPM.QUOTE_NO = PCD.QUOTE_NO
  AND CPM.COMPANY_ID = HPM.COMPANY_ID
  AND PCD.VEHICLE_ID = $P{pvVehicleId} 
  AND PCD.TAX_ID='0'
  AND PCD.DISCOUNT_COVER_ID = '0'
  AND cpm.status='Y'
  AND (SELECT CURRENT_DATE AS TODAY_DATE FROM DUAL) BETWEEN CPM.EFFECTIVE_DATE_START AND CPM.EFFECTIVE_DATE_END]]>
		</queryString>
		<field name="COVER_NAME" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="COVER_NAME"/>
			<property name="com.jaspersoft.studio.field.label" value="COVER_NAME"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="policy_cover_data"/>
		</field>
		<field name="SUM_INSURED" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="SUM_INSURED"/>
			<property name="com.jaspersoft.studio.field.label" value="SUM_INSURED"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="policy_cover_data"/>
		</field>
		<field name="AFTER_DISCOUNT" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="AFTER_DISCOUNT"/>
			<property name="com.jaspersoft.studio.field.label" value="AFTER_DISCOUNT"/>
		</field>
		<field name="INCLUDED_TAX" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="INCLUDED_TAX"/>
			<property name="com.jaspersoft.studio.field.label" value="INCLUDED_TAX"/>
		</field>
	</subDataset>
	<parameter name="pvImagepath" class="java.lang.String"/>
	<parameter name="pvPolicyNo" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
  HPM.POLICY_NO,
  HPM.QUOTE_NO,
  PIF.TITLE_DESC,
  PIF.CLIENT_NAME,
  HPM.DEBIT_NOTE_NO AS INVOICE_NO, 
  PIF.Address_1,
  PIF.Address_2, 
  HPM.inception_date AS FROM_DATE, 
  HPM.expiry_date AS TO_DATE, 
  HPM.expiry_date  AS RENEWAL_DATE, 
  HPM.CURRENCY AS CURRENCY, 
  CASE WHEN hpm.currency IN (cpm.currency_id) THEN MDD.ACTUAL_PREMIUM_LC ELSE MDD.ACTUAL_PREMIUM_FC END AS PREMIUM, 
  CASE WHEN hpm.currency IN (cpm.currency_id) THEN HPM.VAT_PREMIUM_LC
  
   ELSE HPM.VAT_PREMIUM_FC END AS VAT, 
  CASE WHEN hpm.currency IN (cpm.currency_id) THEN MDD.OVERALL_PREMIUM_LC ELSE MDD.OVERALL_PREMIUM_FC END AS TOTAL, 
  HPM.BRANCH_NAME AS PLACE, 
  MDD.INSURANCE_TYPE_DESC INSURANCE_COVER, 
  MDD.COMPANY_NAME AS COMPANY_NAME, 
  HPM.APPROVED_BY AS APPROVED_BY, 
  LUI.USER_NAME AS INTERMEDIARY, 
  LUI.USER_NAME AS PREPARED_BY, 
  LUI.USER_NAME AS PRINTED_BY,
  MDD.VEHICLE_ID AS SNO,
MDD.REGISTRATION_NUMBER AS REG_NO,
MDD.VEHICLE_MAKE,
MDD.VEHCILE_MODEL,
MDD.STICKER_NO,
MDD.VEHICLE_TYPE_DESC,
MDD.CUBIC_CAPACITY AS CC,
MDD.MANUFACTURE_YEAR AS VEHYEAR,
MDD.COLOR_DESC,
MDD.SEATING_CAPACITY NO_OF_SEATS,
MDD.POLICY_TYPE_DESC AS POLICY_TYPE_DESC,
MDD.SUM_INSURED AS SUM_INSURED,
MDD.CHASSIS_NUMBER,
MDR.DRIVER_ID, 
MDR.DRIVER_NAME, 
MDR.DRIVER_TYPEDESC, 
MDR.DRIVER_DOB, 
MDR.ID_NUMBER,
PCD.COVER_NAME,
PCD.EXCESS_PERCENT,
PCD.EXCESS_AMOUNT,
PCD.EXCESS_DESC
FROM 
  home_position_master HPM, 
  MOTOR_DATA_DETAILS MDD,
  MOTOR_DRIVER_DETAILS MDR,
  LOGIN_USER_INFO LUI, 
  eway_insurance_company_master cpm,
  Personal_info PIF,
  POLICY_COVER_DATA PCD
WHERE 
  MDD.POLICY_NO = HPM.POLICY_NO
  AND MDR.QUOTE_NO = HPM.QUOTE_NO
  AND MDD.VEHICLE_ID = MDR.RISK_ID
  AND PCD.QUOTE_NO = HPM.QUOTE_NO
  AND PCD.TAX_ID = '0'
  AND PCD.DISCOUNT_COVER_ID = '0'
  AND PCD.COVERAGE_TYPE = 'B'
  AND MDD.VEHICLE_ID = PCD.VEHICLE_ID
  AND PIF.Customer_Id = HPM.Customer_Id
  AND HPM.LOGIN_ID = LUI.LOGIN_ID 
  AND cpm.company_id = hpm.company_id 
  AND cpm.status='Y'
  AND (SELECT CURRENT_DATE AS TODAY_DATE FROM DUAL) BETWEEN CPM.EFFECTIVE_DATE_START AND CPM.EFFECTIVE_DATE_END
  AND HPM.POLICY_NO = $P{pvPolicyNo}]]>
	</queryString>
