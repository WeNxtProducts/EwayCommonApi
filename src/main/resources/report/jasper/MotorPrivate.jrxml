			<property name="com.jaspersoft.studio.field.name" value="VEH_BODY"/>
			<property name="com.jaspersoft.studio.field.label" value="VEH_BODY"/>
		</field>
		<field name="CC" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="CC"/>
			<property name="com.jaspersoft.studio.field.label" value="CC"/>
		</field>
		<field name="VEHYEAR" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="VEHYEAR"/>
			<property name="com.jaspersoft.studio.field.label" value="VEHYEAR"/>
		</field>
		<field name="COLOR" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="COLOR"/>
			<property name="com.jaspersoft.studio.field.label" value="COLOR"/>
		</field>
		<field name="NO_OF_SEATS" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="NO_OF_SEATS"/>
			<property name="com.jaspersoft.studio.field.label" value="NO_OF_SEATS"/>
		</field>
		<field name="STICKER" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="STICKER"/>
			<property name="com.jaspersoft.studio.field.label" value="STICKER"/>
		</field>
		<field name="WIND_SCREEN_AMT" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="WIND_SCREEN_AMT"/>
			<property name="com.jaspersoft.studio.field.label" value="WIND_SCREEN_AMT"/>
		</field>
		<field name="SUM_INSURED" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="SUM_INSURED"/>
			<property name="com.jaspersoft.studio.field.label" value="SUM_INSURED"/>
		</field>
	</subDataset>
	<parameter name="pvImagepath" class="java.lang.String"/>
	<parameter name="pvPolicyNo" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
HPM.POLICY_NO,
HPM.customer_name AS INSURED_NAME,
HPM.DEBIT_NOTE_NO AS INVOICE_NO,
(SELECT CONCAT_WS(" ",PIF.Address_1,PIF.Address_2)  FROM personal_info  PIF WHERE PIF.Customer_Id=HPM.Customer_Id )  AS POSTAL_ADDRESS,
DATE_FORMAT(HPM.inception_date,"%d/%m/%Y") AS FROM_DATE,
DATE_FORMAT(HPM.expiry_date,"%d/%m/%Y") AS TO_DATE,
DATE_FORMAT(DATE_ADD(HPM.expiry_date,INTERVAL 1 DAY),"%d/%m/%Y") AS RENEWAL_DATE,
HPM.CURRENCY AS CURRENCY,
CASE WHEN hpm.currency IN (cpm.currency_ids) THEN HPM.PREMIUM_LC ELSE HPM.PREMIUM_FC END AS PREMIUM,
CASE WHEN hpm.currency IN (cpm.currency_ids) THEN HPM.VAT_PREMIUM_LC ELSE HPM.VAT_PREMIUM_FC END AS VAT,
CASE WHEN hpm.currency IN (cpm.currency_ids) THEN HPM.OVERALL_PREMIUM_LC ELSE HPM.OVERALL_PREMIUM_FC END AS TOTAL,
HPM.BRANCH_NAME AS PLACE,
MDD.INSURANCE_TYPE_DESC INSURANCE_COVER,
DATE_FORMAT(CURDATE(),'%m/%d/%Y') AS DATEVALUE,
MDD.COMPANY_NAME AS COMPANY_NAME,
HPM.APPROVED_BY AS APPROVED_BY,
LUI.USER_NAME AS INTERMEDIARY,
LUI.USER_NAME AS PREPARED_BY,
LUI.USER_NAME AS PRINTED_BY
FROM home_position_master HPM,MOTOR_DATA_DETAILS MDD,LOGIN_USER_INFO LUI, company_product_master cpm
WHERE MDD.POLICY_NO=HPM.POLICY_NO AND HPM.LOGIN_ID=LUI.LOGIN_ID AND cpm.company_id = hpm.company_id
AND cpm.product_id = hpm.product_id AND cpm.amend_id = hpm.amend_id AND  HPM.POLICY_NO= $P{pvPolicyNo} LIMIT 1;]]>
	</queryString>
