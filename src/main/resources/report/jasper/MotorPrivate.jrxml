				<textElement verticalAlignment="Middle">
					<font fontName="Arial" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Use in connection with insured's business Use for social domestic and pleasure purposes. The policy does not cover use for racing, pacemaking, reliability trial or speed testing (or use for practice for any of them) or for hire/reward"]]></textFieldExpression>
