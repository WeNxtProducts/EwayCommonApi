<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="EwayCreditNote" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="c809aacb-bde2-4106-8ddd-a5f5020cd51d">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.xml"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="pvImagePath" class="java.lang.String"/>
	<parameter name="pvPolicyNo" class="java.lang.String"/>
	<queryString>
		<![CDATA[ SELECT 
INFO.USER_NAME AS BROKER_NAME,
PIF.TITLE_DESC ,
PIF.CLIENT_NAME,
PIF.ADDRESS_1,
PIF.ADDRESS_2,
HPM.BRANCH_NAME,
SDD.RISK_ID,
SDD.SECTION_DESC,
HPM.CREDIT_NO,
HPM.CURRENCY,
CASE WHEN HPM.ORIGINAL_POLICY_NO IS NULL THEN 'NEW BUSINESS' ELSE 'ENDORSEMENT' END AS BUSINESS,
CASE WHEN HPM.ORIGINAL_POLICY_NO IS NULL THEN HPM.POLICY_NO ELSE HPM.ORIGINAL_POLICY_NO END AS POLICY_NO,
CASE WHEN HPM.ORIGINAL_POLICY_NO IS NOT NULL THEN HPM.POLICY_NO ELSE NULL END AS ENDORSEMENT_NO,
HPM.ENDT_TYPE_ID AS ENDT_CODE,
HPM.ENDT_TYPE_DESC ,
HPM.INCEPTION_DATE,
HPM.EXPIRY_DATE,
HPM.AGENCY_CODE,
HPM.CUSTOMER_ID,
INFO.USER_NAME AS  PREPARED_BY,
HPM.APPROVED_BY AS APPROVED_BY,
CASE WHEN HPM.ENDT_COUNT= '0' THEN HPM.COMMISSION 
     ELSE 
        CASE
        WHEN HPM.CREDIT_NO IS NOT NULL THEN HPM.COMMISSION
        END
END AS PREMIUM,
CASE WHEN HPM.ENDT_COUNT= '0' THEN 
       HPM.VAT_COMMISSION 
     ELSE
       CASE
       WHEN HPM.CREDIT_NO IS NOT NULL THEN HPM.VAT_COMMISSION
        END
END AS VAT_PREMIUM_FC,
CASE WHEN HPM.ENDT_COUNT= '0' THEN 
       HPM.COMMISSION + HPM.VAT_COMMISSION
     ELSE
      CASE
       WHEN HPM.CREDIT_NO IS NOT NULL THEN HPM.COMMISSION + HPM.VAT_COMMISSION
        END
END AS OVERALL_PREMIUM_FC,
0 AS VAT_PERCENT
FROM HOME_POSITION_MASTER HPM INNER JOIN 
PERSONAL_INFO PIF ON HPM.CUSTOMER_ID = PIF.CUSTOMER_ID
LEFT JOIN EWAY_INSURANCE_COMPANY_MASTER COMP ON 
HPM.CURRENCY = COMP.CURRENCY_ID AND HPM.COMPANY_ID = COMP.COMPANY_ID
INNER JOIN LOGIN_USER_INFO INFO ON HPM.LOGIN_ID = INFO.LOGIN_ID
LEFT JOIN SECTION_DATA_DETAILS SDD ON HPM.QUOTE_NO=SDD.QUOTE_NO
WHERE
COMP.AMEND_ID= (SELECT MAX(AMEND_ID) FROM EWAY_INSURANCE_COMPANY_MASTER
      WHERE COMPANY_ID=COMP.COMPANY_ID )
AND HPM.STATUS='P'
AND HPM.POLICY_NO= $P{pvPolicyNo} 
ORDER BY HPM.ENTRY_DATE DESC ;]]>
	</queryString>
