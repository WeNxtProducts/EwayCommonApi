	<subDataset name="Table Dataset 1" uuid="c4b19629-7b79-4fb5-bbf1-b74abd7ec655">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.xml"/>
		<parameter name="pvPolicyNo" class="java.lang.String"/>
		<queryString language="SQL">
			<![CDATA[SELECT section_desc FROM SECTION_DATA_DETAILS WHERE Quote_no= (SELECT quote_no FROM home_position_master WHERE policy_no = $P{pvPolicyNo} )]]>
		</queryString>
		<field name="section_desc" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="SECTION_DESC"/>
			<property name="com.jaspersoft.studio.field.label" value="section_desc"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="section_data_details"/>
		</field>
	</subDataset>
	<subDataset name="Table Dataset 2" uuid="ee75558a-5a89-4824-9523-d99f30c6b414">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.xml"/>
		<parameter name="pvPolicyNo" class="java.lang.String"/>
		<queryString language="SQL">
			<![CDATA[SELECT DISTINCT CORE_APP_CODE FROM PRODUCT_SECTION_MASTER PSD
WHERE  STATUS='Y' AND (PRODUCT_ID,COMPANY_ID,SECTION_ID) IN (SELECT PRODUCT_ID,COMPANY_ID,SECTION_ID FROM section_data_details
WHERE QUOTE_NO=(SELECT QUOTE_NO FROM HOME_POSITION_MASTER WHERE POLICY_NO= $P{pvPolicyNo} ))
AND AMEND_ID = (SELECT MAX(AMEND_ID) FROM PRODUCT_SECTION_MASTER
WHERE PRODUCT_ID=PSD.PRODUCT_ID AND COMPANY_ID=PSD.COMPANY_ID AND SECTION_ID=PSD.SECTION_ID AND STATUS='Y')]]>
		</queryString>
		<field name="CORE_APP_CODE" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="CORE_APP_CODE"/>
			<property name="com.jaspersoft.studio.field.label" value="CORE_APP_CODE"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="product_section_master"/>
		</field>
	</subDataset>
	<parameter name="pvImagePath" class="java.lang.String"/>
	<parameter name="pvPolicyNo" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
INFO.USER_NAME AS BROKER_NAME,
PIF.TITLE_DESC ,
PIF.CLIENT_NAME,
PIF.ADDRESS_1,
PIF.PIN_CODE AS PO_BOX,
PIF.STATE_NAME AS REGION_NAME,
PIF.CITY_NAME AS DISTRICT_NAME,
(SELECT COUNTRY_NAME FROM EWAY_COUNTRY_MASTER WHERE COUNTRY_ID=PIF.NATIONALITY AND COMPANY_ID=HPM.COMPANY_ID AND STATUS='Y') AS COUNTRY_NAME,
HPM.BRANCH_NAME,
HPM.CREDIT_NO,
HPM.CURRENCY,
HPM.PRODUCT_NAME,
CASE WHEN HPM.ENDT_COUNT= '0'  THEN 'NEW BUSINESS' ELSE 'ENDORSEMENT' END AS BUSINESS,
CASE WHEN HPM.ORIGINAL_POLICY_NO IS NULL THEN HPM.POLICY_NO ELSE HPM.ORIGINAL_POLICY_NO END AS POLICY_NO,
CASE WHEN HPM.ORIGINAL_POLICY_NO IS NOT NULL THEN HPM.POLICY_NO ELSE NULL END AS ENDORSEMENT_NO,
HPM.ENDT_TYPE_ID AS ENDT_CODE,
HPM.ENDT_TYPE_DESC ,
HPM.ENDORSEMENT_REMARKS,
HPM.INCEPTION_DATE,
HPM.EXPIRY_DATE,
HPM.AGENCY_CODE,
HPM.CUSTOMER_ID,
INFO.USER_NAME AS  PREPARED_BY,
HPM.APPROVED_BY AS APPROVED_BY,
CASE WHEN HPM.ENDT_COUNT= '0' THEN HPM.COMMISSION 
     ELSE 
        CASE
        WHEN HPM.CREDIT_NO IS NOT NULL THEN HPM.COMMISSION
        END
END AS PREMIUM,
CASE WHEN HPM.ENDT_COUNT= '0' THEN 
       (HPM.COMMISSION*HPM.VAT_PERCENT)/100 
     ELSE
       CASE
       WHEN HPM.CREDIT_NO IS NOT NULL THEN (HPM.COMMISSION*HPM.VAT_PERCENT)/100 
        END
END AS VAT_PREMIUM_FC,
CASE WHEN HPM.ENDT_COUNT= '0' THEN 
       HPM.COMMISSION + (HPM.COMMISSION*HPM.VAT_PERCENT)/100 
     ELSE
      CASE
       WHEN HPM.CREDIT_NO IS NOT NULL THEN HPM.COMMISSION + (HPM.COMMISSION*HPM.VAT_PERCENT)/100 
        END
END AS OVERALL_PREMIUM_FC,
VAT_PERCENT AS VAT_PERCENT
FROM HOME_POSITION_MASTER HPM INNER JOIN 
PERSONAL_INFO PIF ON HPM.CUSTOMER_ID = PIF.CUSTOMER_ID
LEFT JOIN EWAY_INSURANCE_COMPANY_MASTER COMP ON 
HPM.CURRENCY = COMP.CURRENCY_ID AND HPM.COMPANY_ID = COMP.COMPANY_ID
INNER JOIN LOGIN_USER_INFO INFO ON HPM.LOGIN_ID = INFO.LOGIN_ID
WHERE
COMP.AMEND_ID= (SELECT MAX(AMEND_ID) FROM EWAY_INSURANCE_COMPANY_MASTER
      WHERE COMPANY_ID=COMP.COMPANY_ID )
AND HPM.STATUS = 'P'
AND HPM.POLICY_NO= $P{pvPolicyNo} 
ORDER BY HPM.ENTRY_DATE DESC]]>
	</queryString>
