	<parameter name="pvPolicyNo" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[WITH COVER_DETAILS AS(
SELECT
 PGM.BAND_DESC AS GROUP_DESC,
 PLAN_TYPE_DESC,
 COVER_NAME,
 (SELECT SUM(SUM_INSURED) FROM POLICY_COVER_DATA 
 WHERE VEHICLE_ID = TPD.TRAVEL_ID AND HPM.QUOTE_NO=QUOTE_NO)  AS SUM_INSURED,
 RATE,
 PCD.CURRENCY,
 TAX_RATE,
 CASE
   WHEN PCD.CURRENCY IN (
     SELECT CURRENCY_ID
     FROM EWAY_INSURANCE_COMPANY_MASTER
     WHERE PCD.COMPANY_ID = COMPANY_ID
   ) THEN PREMIUM_INCLUDED_TAX_LC
   ELSE PREMIUM_INCLUDED_TAX_FC
 END AS PREMIUM
 FROM
 HOME_POSITION_MASTER HPM,
 TRAVEL_PASSENGER_DETAILS TPD ,
 PRODUCT_GROUP_MASTER PGM,
 POLICY_COVER_DATA PCD
 WHERE 
 TPD.QUOTE_NO=HPM.QUOTE_NO
 AND PGM.GROUP_ID = TPD.GROUP_ID
 AND HPM.PRODUCT_ID='4'
 AND HPM.STATUS='P'
 AND HPM.POLICY_NO = $P{pvPolicyNo} 
 AND HPM.QUOTE_NO=PCD.QUOTE_NO
 AND PCD.VEHICLE_ID = TPD.TRAVEL_ID
 AND DISC_LOAD_ID = '0'
 AND TAX_ID = '0'
 )
 SELECT GROUP_DESC,PLAN_TYPE_DESC,COVER_NAME,SUM_INSURED,RATE,CURRENCY,TAX_RATE,PREMIUM FROM COVER_DETAILS
 GROUP BY GROUP_DESC,PLAN_TYPE_DESC,COVER_NAME,SUM_INSURED,RATE,CURRENCY,TAX_RATE,PREMIUM]]>
	</queryString>
