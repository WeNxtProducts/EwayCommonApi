					<textElement textAlignment="Left" verticalAlignment="Middle">
						<font isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["Herewith an example of questions, as may be posed to you and the answers you provided in the proposal are material, and shold there be discrepancies, it could have an effect on the cover of your policy and in the event of a claim.."]]></textFieldExpression>
