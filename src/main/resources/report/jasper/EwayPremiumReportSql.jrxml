		<parameter name="pvQuoteNo" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT 
  MDD.VEHICLE_ID, 
  MDD.REGISTRATION_NUMBER, 
  MDD.VEHICLE_MAKE_DESC AS MAKE, 
  MDD.VEHCILE_MODEL_DESC AS MODEL, 
  MDD.VEHICLE_TYPE_DESC AS BODY_TYPE, 
  MDD.POLICY_TYPE_DESC AS POLICY_TYPE, 
  (
    SELECT 
      SD.STICKER_NUMBER 
    FROM 
      SECTION_DATA_DETAILS SD 
    WHERE 
      SD.QUOTE_NO = MDD.QUOTE_NO 
      AND SD.RISK_ID = MDD.VEHICLE_ID
  ) AS STICKER_NUMBER, 
  MDD.CUBIC_CAPACITY, 
  MDD.MANUFACTURE_YEAR, 
  MDD.SEATING_CAPACITY, 
  MDD.COLOR_DESC, 
  MDD.SUM_INSURED,
  MDD.CURRENCY,
  MDD.ACTUAL_PREMIUM_FC
FROM 
  MOTOR_DATA_DETAILS MDD 
WHERE 
  MDD.QUOTE_NO =  $P{pvQuoteNo} 
  AND MDD.STATUS != 'D']]>
		</queryString>
