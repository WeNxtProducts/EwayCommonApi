	<parameter name="pvProductId" class="java.lang.String"/>
	<parameter name="pvBranch" class="java.lang.String"/>
	<parameter name="pvStartDate" class="java.lang.String"/>
	<parameter name="pvEndDate" class="java.lang.String"/>
	<parameter name="pvLoginId" class="java.lang.String"/>
	<parameter name="pvImagepath" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
  HPM.LOGIN_ID, 
  HPM.QUOTE_NO, 
  HPM.POLICY_NO,
  HPM.NO_OF_VEHICLES, 
  UPPER(
    CONCAT(
      CONCAT(PIF.TITLE_DESC, '.'), 
      PIF.CLIENT_NAME
    )
  ) AS CUSTOMER_NAME, 
  HPM.inception_date AS START_DATE, 
  HPM.expiry_date AS END_DATE, 
  HPM.effective_date AS ISSUE_DATE, 
  UPPER(HPM.BRANCH_NAME) AS BRANCH_NAME, 
  CASE WHEN HPM.SOURCE_TYPE IN(
    'Premia Broker', 'Premia Direct', 
    'Premia Agent'
  ) THEN HPM.CUSTOMER_NAME ELSE(
    SELECT 
      UPPER(USER_NAME) 
    FROM 
      login_user_info 
    WHERE 
      agency_code = (
        SELECT 
          DISTINCT oa_code 
        FROM 
          eway_login_master 
        WHERE 
          login_id = HPM.LOGIN_ID
      )
  ) END AS BROKER_NAME, 
  (
    CASE WHEN HPM.USER_TYPE = 'User' THEN (
      SELECT 
        UPPER(USER_NAME) 
      FROM 
        login_user_info 
      WHERE 
        LOGIN_ID = HPM.LOGIN_ID
    ) ELSE '' END
  ) AS USER_NAME, 
  HPM.USER_TYPE AS USER_TYPE, 
  HPM.SUB_USER_TYPE AS SUB_USER_TYPE, 
  HPM.CURRENCY, 
  PY.PAYMENT_ID,
  PD.PAYMENT_TYPEDESC AS PAYMENT_TYPE,
  PD.MERCHANT_REFERENCE,
  PD.AUTH_TRANS_REF_NO,
  HPM.PRODUCT_NAME, 
  HPM.DEBIT_NOTE_NO, 
  (
    SELECT 
      SUM(SUM_INSURED) 
    FROM 
      POLICY_COVER_DATA 
    WHERE 
      QUOTE_NO = HPM.QUOTE_NO 
      AND TAX_ID = '0' 
      AND DISC_LOAD_ID = '0' 
      AND COVERAGE_TYPE = 'B'
  ) AS SUM_INSURED, 
  HPM.OVERALL_PREMIUM_FC AS PERMIUM, 
  ROUND(HPM.COMMISSION_PERCENTAGE, 1) AS COMMISSION_PERCENTAGE, 
  ROUND(COMMISSION) AS COMMISSION_AMOUNT 
FROM 
  HOME_POSITION_MASTER HPM, 
  PERSONAL_INFO PIF,
  PAYMENT_INFO PY,
  PAYMENT_DETAIL PD
WHERE 
  HPM.CUSTOMER_ID = PIF.CUSTOMER_ID 
  AND PY.QUOTE_NO = HPM.QUOTE_NO
  AND PY.PAYMENT_STATUS = 'ACCEPTED'
  AND PD.QUOTE_NO = PY.QUOTE_NO
  AND PD.PAYMENT_ID = PY.PAYMENT_ID
  AND HPM.PRODUCT_ID = $P{pvProductId} 
  AND (
    CASE WHEN '99999' = $P{pvBranch} THEN '1' ELSE HPM.BRANCH_CODE END
  ) = (
    CASE WHEN '99999' = $P{pvBranch} THEN '1' ELSE $P{pvBranch} END
  ) 
  AND HPM.STATUS = 'P' 
  AND HPM.POLICY_NO IS NOT NULL 
  AND REGEXP_SUBSTR(HPM.ENTRY_DATE, '[^ ]+') BETWEEN $P{pvStartDate} 
  AND $P{pvEndDate} 
  AND (
    (
      CASE WHEN (
        SELECT 
          SUB_USER_TYPE 
        FROM 
          eway_login_master 
        WHERE 
          LOGIN_ID = $P{pvLoginId}
      ) IN ('both', 'high') THEN '1' WHEN (
        SELECT 
          SUB_USER_TYPE 
        FROM 
          eway_login_master 
        WHERE 
          LOGIN_ID = $P{pvLoginId}
      ) IN ('low') THEN HPM.Application_id END
    ) = (
      CASE WHEN (
        SELECT 
          SUB_USER_TYPE 
        FROM 
          eway_login_master 
        WHERE 
          LOGIN_ID = $P{pvLoginId}
      ) IN ('both', 'high') THEN '1' ELSE $P{pvLoginId} END
    ) 
    OR (
      CASE WHEN (
        SELECT 
          USER_TYPE 
        FROM 
          eway_login_master 
        WHERE 
          LOGIN_ID = $P{pvLoginId}
      )= 'Broker' THEN HPM.AGENCY_CODE END
    ) IN (
      SELECT 
        DISTINCT AGENCY_CODE 
      FROM 
        eway_login_master 
      WHERE 
        OA_CODE IN (
          SELECT 
            AGENCY_CODE 
          FROM 
            eway_login_master 
          WHERE 
            LOGIN_ID = $P{pvLoginId}
        )
    ) 
    OR HPM.AGENCY_CODE IN (
      SELECT 
        AGENCY_CODE 
      FROM 
        eway_login_master 
      WHERE 
        LOGIN_ID = $P{pvLoginId}
    )
  ) 
ORDER BY 
  BRANCH_NAME, 
  BROKER_NAME, 
  USER_NAME DESC]]>
	</queryString>
