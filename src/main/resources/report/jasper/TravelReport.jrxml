				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Arial" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["In the event of a medical emergency or security emergency, the Insured Person should contact the 24 HOUR EMERGENCY ASSISTANCE HELPLINE:"]]></textFieldExpression>
			</textField>
