		<band height="27">
			<textField>
				<reportElement uuid="b30de211-e30f-4854-ace8-55685c823f1a" x="0" y="7" width="554" height="10"/>
				<box leftPadding="2"/>
				<textElement>
					<font fontName="Arial" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Insured Persons qualify for the Medical and Emergency Related Expenses listed in the Schedule of Covers of the"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement uuid="19d32d6c-98f1-42c9-afa2-f6bcadf577e3" x="0" y="17" width="554" height="10"/>
				<box leftPadding="2"/>
				<textElement>
					<font fontName="Arial" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Policy Certificate Nº 52ASIALT up to the following limits:"]]></textFieldExpression>
			</textField>
		</band>
		<band height="14">
			<textField>
				<reportElement uuid="1b8e627a-ffe3-40b0-835e-8f3a6ca9f820" x="0" y="4" width="554" height="10"/>
				<box leftPadding="2"/>
				<textElement>
					<font fontName="Arial Rounded MT Bold" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["MEDICAL TRANSPORTATION OR REPATRIATION: 15000"]]></textFieldExpression>
			</textField>
		</band>
		<band height="14">
			<textField>
				<reportElement uuid="5ec84006-f1ed-44d3-89b0-e18cb018ebfd" x="0" y="4" width="554" height="10"/>
				<box leftPadding="2"/>
				<textElement>
					<font fontName="Arial Rounded MT Bold" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["MEDICAL EXPENSES ABROAD (Including COVID-19): 30000"]]></textFieldExpression>
			</textField>
		</band>
		<band height="34">
			<textField>
				<reportElement uuid="d437a5f9-f216-4a45-85df-0cf7082ac651" x="0" y="4" width="554" height="10"/>
				<box leftPadding="1"/>
				<textElement>
					<font fontName="Arial" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["If an Insured Event occurs after the commencement of a Journey giving rise to a valid claim, the Journey will automatically be extended within"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement uuid="9484a4ae-b375-4f6c-afd6-0ebcc894b176" x="0" y="14" width="554" height="10"/>
				<box leftPadding="1"/>
				<textElement>
					<font fontName="Arial" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["the Terms & Conditions of the Policy. All Benefits are subject to the Terms & Conditions of the Policy and details of the sums insured, sub-"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement uuid="4e3810cc-4ec8-4de8-977c-0282c3823c89" x="0" y="24" width="554" height="10"/>
				<box leftPadding="1"/>
				<textElement>
					<font fontName="Arial" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["limits and excesses are contained in the Schedule of Covers."]]></textFieldExpression>
			</textField>
		</band>
		<band height="14">
			<textField>
				<reportElement uuid="fe3de5a7-b0dc-407e-8847-45d0ab5a1238" x="0" y="4" width="554" height="10"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Arial" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["In the event of a medical emergency or security emergency, the Insured Person should contact the 24 HOUR EMERGENCY ASSISTANCE HELPLINE:"]]></textFieldExpression>
			</textField>
		</band>
		<band height="21">
