<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="EwayMotorCoverNote" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="8d1467b8-4c0f-4241-b2bf-6ba278d799c9">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.xml"/>
	<parameter name="pvImagePath" class="java.lang.String"/>
	<parameter name="pvPolicyNo" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[WITH motor AS (
SELECT 
  MDD.Vehicle_Id,
  PIF.TITLE_DESC AS INSURED_TITLE,
  PIF.CLIENT_NAME AS INSURED_NAME,
  CASE WHEN HPM.SOURCE_TYPE IN ('Premia Broker','Premia Direct','Premia Agent') THEN HPM.CUSTOMER_NAME
       ELSE  (SELECT 
      UPPER(USER_NAME) 
    FROM 
      login_user_info 
    WHERE 
      LOGIN_ID = HPM.LOGIN_ID)
  END  AS INSURER_NAME,
  HPM.INCEPTION_DATE AS PAYMENT_DATE,
    HPM.INCEPTION_DATE AS DATE_OF_ISSUE,
HPM.INCEPTION_DATE AS START_DATE,
HPM.EXPIRY_DATE AS END_DATE,
HPM.COVERNOTE_REFERENCENO AS COVERNOTE_NO,
HPM.STICKER_NUMBER,
 MDD.REGISTRATION_NUMBER,
 MDD.VEHICLE_TYPE_DESC AS BODY_TYPE,
CASE WHEN MDD.VEHCILE_MODEL_DESC IS NOT NULL THEN MDD.VEHCILE_MODEL_DESC
ELSE (SELECT vehiclemodelcode FROM eway_motor_makemodel_master WHERE MODEL_NUMBER=MDD.MODEL_NUMBER AND COMPANY_ID=HPM.COMPANY_ID
AND STATUS='Y' AND AMEND_ID=(SELECT MAX(AMEND_ID) FROM eway_motor_makemodel_master WHERE 
MODEL_NUMBER=MDD.MODEL_NUMBER AND COMPANY_ID=HPM.COMPANY_ID
AND STATUS='Y' )) 
END AS MODEL_TYPE,
MDD.COLOR_DESC,
MDD.CUBIC_CAPACITY AS ENGINE_CAPACITY,
MDD.VEHICLE_MAKE_DESC AS MAKE_TYPE,
MDD.CHASSIS_NUMBER,
MDD.SEATING_CAPACITY,
MDD.ENGINE_NUMBER,
MDD.FUEL_TYPE,
MDD.POLICY_TYPE_DESC AS MOTOR_USAGE,
MDD.MANUFACTURE_YEAR,
LUI.USER_NAME AS AGENT_NAME,
LUI.USER_MOBILE AS AGENT_MOBILE,
  HPM.COMPANY_NAME,
  HPM.BRANCH_NAME AS PLACE,
  HPM.CURRENCY,
MDD.STICKER_NO,
MDD.SECTION_NAME,
MDD.VEHCILE_MODEL_DESC AS MODEL_NUMBER,
CASE WHEN HPM.CURRENCY IN(COMP.CURRENCY_ID) THEN ROUND(HPM.PREMIUM_LC,2) ELSE ROUND(HPM.PREMIUM_FC,2) END AS PREMIUM,
CASE WHEN HPM.CURRENCY IN(COMP.CURRENCY_ID) THEN ROUND(HPM.VAT_PREMIUM_LC,2) ELSE ROUND(HPM.VAT_PREMIUM_FC,2) END AS VAT_PREMIUM,
CASE WHEN HPM.CURRENCY IN(COMP.CURRENCY_ID) THEN ROUND(HPM.OVERALL_PREMIUM_LC,2) ELSE ROUND(HPM.OVERALL_PREMIUM_FC,2) END AS OVERALL_PREMIUM
 FROM HOME_POSITION_MASTER HPM
  INNER JOIN
  PERSONAL_INFO PIF ON HPM.CUSTOMER_ID = PIF.CUSTOMER_ID
 INNER JOIN MOTOR_DATA_DETAILS MDD ON MDD.QUOTE_NO = HPM.QUOTE_NO
 INNER JOIN LOGIN_USER_INFO LUI ON LUI.LOGIN_ID=HPM.LOGIN_ID
 LEFT JOIN EWAY_INSURANCE_COMPANY_MASTER COMP ON 
 HPM.CURRENCY = COMP.CURRENCY_ID AND HPM.COMPANY_ID = COMP.COMPANY_ID
 WHERE
 COMP.AMEND_ID= (SELECT MAX(AMEND_ID) FROM EWAY_INSURANCE_COMPANY_MASTER
      WHERE COMPANY_ID=COMP.COMPANY_ID )
 AND
 HPM.PRODUCT_ID='46'
 AND HPM.STATUS='P'
 AND HPM.POLICY_NO=  $P{pvPolicyNo}  )
 SELECT * FROM motor WHERE vehicle_id='1';]]>
	</queryString>
