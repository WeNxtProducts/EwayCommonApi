		<band height="129">
			<textField>
				<reportElement x="5" y="15" width="545" height="114" uuid="3d9b25a8-4444-4a2c-9c26-1c271c19a81b">
					<property name="com.jaspersoft.studio.unit.y" value="px"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<box leftPadding="2"/>
				<textElement markup="html">
					<font fontName="Arial" size="10"/>
					<paragraph lineSpacing="1_1_2" lineSpacingSize="1.0"/>
				</textElement>
				<textFieldExpression><![CDATA["The policyholder description in the certifcate below having proposed for insurance in respect of the Motor Vehicle described in the Certifcate and having paid sum of "+"<b>"+new java.text.DecimalFormat("#,##0.00").format($F{OVERALL_PREMIUM})+" "+$F{CURRENCY}+"</b>"+" as premium. The risk is hereby applicable for the period between the dates specifed in the Certifcate unless the cover be terminated by the Company notice in writing in which case the insurance will thereupon cease and a proportionate part of the annual premium otherwise payable for such insurance will be charged for the time the Company has been on risk. The Policyholder warrants that the Motor Vehicle is only used for the purpose of "+"<b>"+$F{SECTION_NAME}+", "+$F{MOTOR_USAGE}+"<b>"]]></textFieldExpression>
			</textField>
		</band>
