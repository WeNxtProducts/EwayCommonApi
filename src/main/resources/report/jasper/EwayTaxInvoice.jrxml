	<parameter name="pvImagePath" class="java.lang.String"/>
	<parameter name="pvPolicyNo" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
LUI.USER_NAME AS PRINTED_BY,
HPM.APPROVED_BY AS APPROVED_BY,
LUI.USER_NAME,
HPM.AGENCY_CODE,
PIF.TITLE_DESC ,
PIF.CLIENT_NAME,
PIF.ADDRESS_1,
PIF.ADDRESS_2,
PIF.VR_TIN_NO,
HPM.POLICY_NO,
HPM.INCEPTION_DATE,
HPM.EXPIRY_DATE,
HPM.CURRENCY ,
 MDD.SECTION_NAME  SECTION_NAME,
 MDD.REGISTRATION_NUMBER,
 CASE WHEN HPM.CURRENCY IN (
    SELECT 
      CURRENCY_ID 
    FROM 
      EWAY_INSURANCE_COMPANY_MASTER 
    WHERE 
      HPM.COMPANY_ID = COMPANY_ID
  ) THEN ROUND(HPM.PREMIUM_LC,2) ELSE ROUND(HPM.PREMIUM_FC,2) END AS PERMIUM, 
   CASE WHEN HPM.CURRENCY IN (
    SELECT 
      CURRENCY_ID 
    FROM 
      EWAY_INSURANCE_COMPANY_MASTER 
    WHERE 
      HPM.COMPANY_ID = COMPANY_ID
  ) THEN ROUND(HPM.VAT_PREMIUM_LC,2) ELSE ROUND(HPM.VAT_PREMIUM_FC,2) END AS VAT_PERMIUM, 
     CASE WHEN HPM.CURRENCY IN (
    SELECT 
      CURRENCY_ID 
    FROM 
      EWAY_INSURANCE_COMPANY_MASTER 
    WHERE 
      HPM.COMPANY_ID = COMPANY_ID
  ) THEN ROUND(HPM.OVERALL_PREMIUM_LC,2) ELSE ROUND(HPM.OVERALL_PREMIUM_FC,2) END AS OVERALL_PREMIUM, 
  HPM.VAT_PERCENT,
  PD.BANK_NAME,
  PD.ACCOUNT_NUMBER,
  (SELECT SUM(SUM_INSURED) FROM motor_data_details WHERE MDD.QUOTE_NO=QUOTE_NO) AS TOTAL_SUM_INSURED
FROM HOME_POSITION_MASTER HPM INNER JOIN PERSONAL_INFO PIF ON HPM.CUSTOMER_ID=PIF.CUSTOMER_ID
LEFT JOIN PAYMENT_DETAIL  PD ON PD.QUOTE_NO = HPM.QUOTE_NO
LEFT JOIN MOTOR_DATA_DETAILS MDD
ON HPM.QUOTE_NO=MDD.QUOTE_NO LEFT JOIN LOGIN_USER_INFO LUI ON HPM.LOGIN_ID=LUI.LOGIN_ID
WHERE HPM.POLICY_NO= $P{pvPolicyNo}]]>
	</queryString>
